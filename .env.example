# Ticket de la API de Compra Ágil (api2.mercadopublico.cl). Secreto — nunca commitear el real.
COMPRA_AGIL_API_TICKET=

# Credenciales ClaveÚnica para el skill compra-agil-ofertar (login al portal). Secreto.
CLAVE_UNICA_RUN=
CLAVE_UNICA_CLAVE=

# Credenciales del login al portal que usa `npm run login-portal` (licitaciones). Son las MISMAS de
# ClaveÚnica: el portal no tiene credencial propia para un RUN chileno — el formulario de usuario y
# contraseña de su Keycloak es la pestaña "Extranjero", para oferentes sin RUN. Secreto.
#   MP_USUARIO = RUN del titular (ej. 12345678-9)   MP_CLAVE = su ClaveÚnica
MP_USUARIO=
MP_CLAVE=

# Ticket de la API clásica de Licitaciones (api.mercadopublico.cl) — DISTINTO del ticket de Compra
# Ágil de arriba. Se solicita en https://www.mercadopublico.cl/Home/Api. Secreto — nunca commitear
# el real.
#
# OPCIONAL: `npm run radar-licitaciones` ya no lo necesita (corre sobre el buscador y la ficha
# pública del portal, sin cuota). Solo lo usa `--con-api`, que agrega `CantidadReclamos`.
LICITACIONES_API_TICKET=
